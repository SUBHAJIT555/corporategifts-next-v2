# Copied into the client bundle at `yarn build` time (NEXT_PUBLIC_*).
# Defaults in lib/config/site.ts work for production if these are unset.

# Public site origin (no trailing slash). Used for canonical URLs / metadata.
NEXT_PUBLIC_SITE_URL=https://corporategiftsdubaii.ae

# WordPress origin hosting WooCommerce + FluentForm (no trailing slash).
NEXT_PUBLIC_WP_ORIGIN=https://corporategiftsdubaii.ae/blog

# Custom WooCommerce REST base. Default: ${NEXT_PUBLIC_WP_ORIGIN}/wp-json/custom/v1
# NEXT_PUBLIC_API_BASE_URL=https://corporategiftsdubaii.ae/blog/wp-json/custom/v1

# FluentForm contact endpoint (form 3). Default: ${NEXT_PUBLIC_WP_ORIGIN}/wp-json/fluentform/v1/form3
# NEXT_PUBLIC_FLUENTFORM_FORM3_URL=https://corporategiftsdubaii.ae/blog/wp-json/fluentform/v1/form3

# Optional legacy contact/newsletter API (Footer subscribe / ContactApi). Not required for FluentForm.
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_CONTACT_API_URL=

# Set by `yarn build` via cross-env; override only if needed.
# NEXT_PUBLIC_ENV=production

# Optional PHP sitemap.php overrides on Hostinger (server env, not Next build):
# PUBLIC_SITE_URL=https://corporategiftsdubaii.ae
# WP_ORIGIN=https://corporategiftsdubaii.ae/blog
